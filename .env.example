DATABASE_URL=postgresql://lexi:lexi@localhost:5432/lexi
NUXT_SESSION_PASSWORD=change-me-to-a-long-random-string-at-least-32-chars

# Max mini-app bot token (from business.max.ru after bot moderation)
MAX_BOT_TOKEN=
NUXT_MAX_BOT_TOKEN=
NUXT_PUBLIC_MAX_BOT_USERNAME=

# Protects POST /api/cron/daily-reminders (host cron uses this)
CRON_SECRET=change-me-cron-secret

# Test auth in browser (buttons on /login). NEVER enable in production.
MAX_TEST_AUTH=0
NUXT_MAX_TEST_AUTH=0
NUXT_PUBLIC_MAX_TEST_AUTH=0
# Alias for MAX_TEST_AUTH (legacy):
MAX_DEV_BYPASS=0

# 0 for local http://localhost, 1 in production HTTPS
SESSION_COOKIE_SECURE=0

APP_PORT=3000
POSTGRES_PORT=5432
